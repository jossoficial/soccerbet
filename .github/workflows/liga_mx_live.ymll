name: Liga MX Live
on:
  workflow_dispatch:

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install -r requirements.txt
      - run: python main_liga_mx.py
        env:
          THESTATS_API_KEY: ${{ secrets.THESTATS_API_KEY }}
          ISPORTS_API_KEY: ${{ secrets.ISPORTS_API_KEY }}
      - uses: actions/upload-artifact@v4
        with:
          name: liga-mx-hoy
          path: liga_mx_hoy_real.xlsx
